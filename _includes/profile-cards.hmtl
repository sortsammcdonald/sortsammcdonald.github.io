<div class="profile-cards">

  {% if site.github_username %}
  <a class="profile-card"
     href="https://github.com/{{ site.github_username | escape }}"
     target="_blank"
     rel="noopener">
    <div class="profile-title">GitHub</div>
    <div class="profile-handle">@{{ site.github_username }}</div>
  </a>
  {% endif %}

  {% if site.twitter_username %}
  <a class="profile-card"
     href="https://x.com/{{ site.twitter_username | escape }}"
     target="_blank"
     rel="noopener">
    <div class="profile-title">X</div>
    <div class="profile-handle">@{{ site.twitter_username }}</div>
  </a>
  {% endif %}

</div>
